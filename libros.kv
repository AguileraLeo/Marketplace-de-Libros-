                    on_release: app.go("create_offer")
                    MDButtonIcon:
                        icon: "hand-extended-outline"
                    MDButtonText:
                        text: "PUEDO OFRECERLO"


<CreateOfferScreen>:
    name: "create_offer"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Crear oferta"
        MDScrollView:
            Page:
                Panel:
                    Heading:
                        id: book_title
                    Muted:
                        id: book_meta
                        role: "small"
                FieldLabel:
                    text: "Precio"
