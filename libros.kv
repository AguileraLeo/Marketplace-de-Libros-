        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            SegmentedRow:
                id: filter
                options: [("todas", "Todas"), ("activas", "Activas"), ("aceptadas", "Aceptadas"), ("finalizadas", "Finalizadas")]
                value: "todas"
                on_value: root.refresh()
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
