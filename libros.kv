                    text: "Solo los verá el lector si acepta tu oferta. Completa al menos uno."
                    role: "small"
                MDTextField:
                    id: phone
                    mode: "outlined"
                    MDTextFieldLeadingIcon:
                        icon: "phone-outline"
                    MDTextFieldHintText:
                        text: "Teléfono"
                MDTextField:
                    id: email
                    mode: "outlined"
                    MDTextFieldLeadingIcon:
                        icon: "email-outline"
                    MDTextFieldHintText:
                        text: "Correo"
                MDTextField:
                    id: address
                    mode: "outlined"
                    MDTextFieldLeadingIcon:
                        icon: "map-marker-outline"
                    MDTextFieldHintText:
                        text: "Dirección o punto de entrega"
                Widget:
                    size_hint_y: None
                    height: dp(4)
                PrimaryButton:
                    on_release: root.publish()
                    MDButtonIcon:
                        icon: "send"
                    MDButtonText:
                        text: "PUBLICAR OFERTA"


