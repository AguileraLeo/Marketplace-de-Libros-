#:kivy 2.3.0
#:import dp kivy.metrics.dp
#:import Role store.Role
#:import Condition store.Condition
#:import Delivery store.Delivery
#:import hex kivy.utils.get_color_from_hex
#:import hexstr kivy.utils.get_hex_from_color
#:set INK "#1A1A17"
#:set MUTED "#5E5B53"
#:set FAINT "#6F6B62"
#:set RULE "#E6E2D9"
#:set FIELD_LINE "#D6D1C6"
#:set TRACK "#EFECE5"


# ==========================================================================
#  Componentes reutilizables
# ==========================================================================

<Heading@MDLabel>:
    font_style: "Title"
    role: "medium"
    bold: True
    adaptive_height: True

<Muted@MDLabel>:
    font_style: "Body"
    role: "medium"
    adaptive_height: True
    theme_text_color: "Custom"
    text_color: app.theme_cls.onSurfaceVariantColor

<FieldLabel@MDLabel>:
    font_style: "Label"
    role: "large"
    bold: True
    adaptive_height: True
    padding: 0, dp(6), 0, 0

<WideButton>:
    theme_width: "Custom"
    size_hint_x: 1
    height: dp(48)
    radius: [dp(6)] * 4

<PrimaryButton@WideButton>:
    style: "filled"
    height: dp(52)

# El hinting "normal" de Kivy abre huecos dentro de palabras en Source Serif ("ofer tas").
<MDLabel>:
    font_hinting: None
    font_kerning: True

<MDTextField>:
    radius: [dp(6)] * 4
    theme_line_color: "Custom"
    line_color_normal: hex(FIELD_LINE)
    line_color_focus: app.theme_cls.primaryColor

<MDTopAppBar>:
    canvas.after:
        Color:
            rgba: hex(RULE)
        Line:
            points: [self.x, self.y, self.right, self.y]

<Page@MDBoxLayout>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(16), dp(12), dp(16), dp(32)
    spacing: dp(12)

<Panel@MDCard>:
    style: "filled"
    theme_bg_color: "Custom"
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(16)
    spacing: dp(10)
    radius: [dp(8)] * 4
    ripple_effect: False
    md_bg_color: hex("#FFFFFF")
    line_color: hex(RULE)

<Gap@Widget>:
    size_hint_y: None
    height: dp(12)

<Rule@Widget>:
    size_hint_y: None
    height: dp(1)
    canvas:
        Color:
            rgba: hex(RULE)
        Rectangle:
            pos: self.pos
            size: self.size

<NextStep@MDBoxLayout>:
    number: ""
    text: ""
    adaptive_height: True
    padding: 0, dp(10)
    MDLabel:
        text: root.number
        size_hint_x: None
        width: dp(30)
        font_style: "Title"
        role: "medium"
        adaptive_height: True
        pos_hint: {"top": 1}
        theme_text_color: "Custom"
        text_color: app.theme_cls.primaryColor
    MDLabel:
        text: root.text
        font_style: "Body"
        role: "large"
        adaptive_height: True
        pos_hint: {"top": 1}
        theme_text_color: "Custom"
        text_color: hex(INK)

<SegmentedRow>:
    adaptive_height: True
    padding: dp(3)
    spacing: dp(2)
    radius: [dp(7)] * 4
    md_bg_color: hex(TRACK)

<SegmentButton>:
    size_hint_y: None
    height: dp(48)
    radius: [dp(5)] * 4
    md_bg_color: hex("#FFFFFF") if self.selected else hex(TRACK)
    line_color: hex(FIELD_LINE) if self.selected else hex(TRACK)
    MDLabel:
        text: root.text
        halign: "center"
        font_style: "Body"
        role: "medium"
        bold: root.selected
        theme_text_color: "Custom"
        text_color: hex(INK) if root.selected else hex(MUTED)

<StatLink@ButtonBehavior+MDBoxLayout>:
    value: "0"
    label: ""
    highlight: False
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(2)
    MDLabel:
        text: root.value
        font_style: "Headline"
        role: "medium"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: app.theme_cls.primaryColor if root.highlight else hex(INK)
    MDLabel:
        text: root.label
        font_style: "Body"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: hex(MUTED)

<RequestRow>:
    orientation: "horizontal"
    size_hint_y: None
    height: max(dp(70), info.minimum_height) + dp(32)
    padding: 0, dp(16)
    spacing: dp(14)
    on_release: root.callback(root) if root.callback else None
    canvas.after:
        Color:
            rgba: hex(RULE)
        Line:
            points: [self.x, self.y, self.right, self.y]
    BookCover:
        source: root.cover
        size: dp(48), dp(70)
        radius: [dp(2)] * 4
        pos_hint: {"top": 1}
    MDBoxLayout:
        id: info
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(2)
        pos_hint: {"top": 1}
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(12)
            MDLabel:
                text: root.title
                font_style: "Title"
                role: "medium"
                adaptive_height: True
                theme_text_color: "Custom"
                text_color: hex(INK)
            MDLabel:
                text: root.price
                markup: True
                font_style: "Body"
                role: "medium"
                adaptive_size: True
                pos_hint: {"top": 1}
                theme_text_color: "Custom"
                text_color: hex(INK)
        MDLabel:
            text: root.author
            font_style: "Body"
            role: "small"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(MUTED)
        MDLabel:
            text: root.meta
            font_style: "Body"
            role: "small"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(MUTED)
        MDBoxLayout:
            adaptive_height: True
            spacing: dp(8)
            padding: 0, dp(6), 0, 0
            StatusChip:
                status: root.status
                kind: "request"
            MDLabel:
                text: root.detail
                font_style: "Body"
                role: "small"
                adaptive_size: True
                theme_text_color: "Custom"
                text_color: hex(FAINT)

<ListBox@MDBoxLayout>:
    orientation: "vertical"
    adaptive_height: True

<BookCover>:
    size_hint: None, None
    size: dp(64), dp(92)
    md_bg_color: hex(TRACK)
    radius: [dp(3)] * 4
    MDIcon:
        icon: "book-open-page-variant"
        pos_hint: {"center_x": .5, "center_y": .5}
        theme_text_color: "Custom"
        text_color: hex(FAINT)
    Image:
        source: root.local_source
        fit_mode: "cover"
        opacity: 1 if root.loaded and root.local_source else 0

<StatusChip>:
    adaptive_size: True
    spacing: dp(8)
    pos_hint: {"center_y": .5}
    Widget:
        size_hint: None, None
        size: dp(7), dp(7)
        pos_hint: {"center_y": .5}
        canvas:
            Color:
                rgba: root.dot
            Ellipse:
                pos: self.pos
                size: self.size
    MDLabel:
        text: root.text or " "
        adaptive_size: True
        font_style: "Body"
        role: "small"
        bold: True
        theme_text_color: "Custom"
        text_color: root.fg

<ItemCard>:
    style: "filled"
    theme_bg_color: "Custom"
    md_bg_color: 0, 0, 0, 0
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: 0, dp(14)
    spacing: dp(2)
    radius: [0] * 4
    ripple_effect: False
    on_release: root.callback(root) if root.callback else None
    canvas.after:
        Color:
            rgba: hex(RULE)
        Line:
            points: [self.x, self.y, self.right, self.y]
    MDBoxLayout:
        adaptive_height: True
        spacing: dp(12)
        MDLabel:
            text: root.title
            font_style: "Title"
            role: "medium"
            adaptive_height: True
            pos_hint: {"center_y": .5}
            theme_text_color: "Custom"
            text_color: hex(INK)
        StatusChip:
            status: root.status
            kind: root.kind
            opacity: 1 if root.status else 0
    MDLabel:
        text: root.subtitle
        font_style: "Body"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: hex(MUTED)
    MDLabel:
        text: root.meta
        font_style: "Body"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: hex(MUTED)
    MDBoxLayout:
        size_hint_y: None
        height: dp(48) if root.action_text else 0
        opacity: 1 if root.action_text else 0
        disabled: not root.action_text
        Widget:
        MDButton:
            style: "text"
            on_release: root.action_callback(root) if root.action_callback else None
            MDButtonText:
                text: root.action_text
                theme_text_color: "Custom"
                text_color: app.theme_cls.errorColor if root.action_text.startswith(("Cancelar", "Suspender")) else app.theme_cls.primaryColor

<BookResultCard>:
    style: "filled"
    theme_bg_color: "Custom"
    md_bg_color: 0, 0, 0, 0
    orientation: "horizontal"
    size_hint_y: None
    height: max(dp(70), content.minimum_height) + dp(32)
    padding: 0, dp(16)
    spacing: dp(14)
    radius: [0] * 4
    ripple_effect: False
    canvas.after:
        Color:
            rgba: hex(RULE)
        Line:
            points: [self.x, self.y, self.right, self.y]
    BookCover:
        source: root.cover
        size: dp(48), dp(70)
        pos_hint: {"top": 1}
    MDBoxLayout:
        id: content
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(2)
        pos_hint: {"top": 1}
        MDLabel:
            text: root.title
            font_style: "Title"
            role: "medium"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(INK)
        MDLabel:
            text: root.subtitle
            font_style: "Body"
            role: "small"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(MUTED)
        MDLabel:
            text: root.meta
            font_style: "Body"
            role: "small"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(MUTED)
        MDBoxLayout:
            adaptive_height: True
            padding: 0, dp(6), 0, 0
            Widget:
            MDButton:
                style: "outlined"
                radius: [dp(6)] * 4
                on_release: app.select_book(root.book)
                MDButtonText:
                    text: "Seleccionar"

<StatTile>:
    style: "filled"
    theme_bg_color: "Custom"
    md_bg_color: hex("#FFFFFF")
    line_color: hex(RULE)
    orientation: "vertical"
    size_hint_y: None
    height: dp(84)
    padding: dp(14), dp(10)
    radius: [dp(6)] * 4
    ripple_effect: False
    MDBoxLayout:
        adaptive_height: True
        MDLabel:
            text: root.value
            font_style: "Headline"
            role: "medium"
            theme_text_color: "Custom"
            text_color: hex(INK)
        Widget:
        MDIcon:
            icon: root.icon
            theme_text_color: "Custom"
            text_color: hex(FAINT)
            pos_hint: {"center_y": .6}
    MDLabel:
        text: root.label
        font_style: "Body"
        role: "small"
        theme_text_color: "Custom"
        text_color: hex(MUTED)

<InfoRow>:
    adaptive_height: True
    spacing: dp(14)
    padding: 0, dp(4)
    MDIcon:
        icon: root.icon
        pos_hint: {"center_y": .5}
        theme_text_color: "Custom"
        text_color: app.theme_cls.primaryColor
    MDBoxLayout:
        orientation: "vertical"
        adaptive_height: True
        pos_hint: {"center_y": .5}
        Muted:
            text: root.label
            font_style: "Label"
            role: "medium"
        MDLabel:
            text: root.value
            font_style: "Body"
            role: "large"
            adaptive_height: True

<EmptyState>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(16), dp(28)
    spacing: dp(8)
    MDIcon:
        icon: root.icon
        pos_hint: {"center_x": .5}
        theme_text_color: "Custom"
        text_color: app.theme_cls.outlineColor
    Muted:
        text: root.text
        halign: "center"

# Encabezado de libro reutilizado en detalles (ids: cover, book_title, book_meta, status)
<BookHeader@Panel>:
    orientation: "horizontal"
    spacing: dp(14)

# Marca de la app: libro + insignia de interrogación ("¿quién lo tiene?")
<BrandMark@MDRelativeLayout>:
    size_hint: None, None
    size: dp(88), dp(88)
    pos_hint: {"center_x": .5}
    MDCard:
        style: "filled"
        theme_bg_color: "Custom"
        md_bg_color: app.theme_cls.primaryColor
        radius: [dp(14)] * 4
        ripple_effect: False
        MDIcon:
            icon: "book-open-page-variant"
            font_size: "40sp"
            pos_hint: {"center_x": .5, "center_y": .5}
            theme_text_color: "Custom"
            text_color: app.theme_cls.onPrimaryColor
    MDCard:
        style: "filled"
        theme_bg_color: "Custom"
        md_bg_color: app.theme_cls.backgroundColor
        line_color: app.theme_cls.primaryColor
        radius: [dp(15)] * 4
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"right": 1, "y": 0}
        ripple_effect: False
        MDIcon:
            icon: "help"
            font_size: "18sp"
            pos_hint: {"center_x": .5, "center_y": .5}
            theme_text_color: "Custom"
            text_color: app.theme_cls.primaryColor

# Barra superior con botón "atrás"
<BackBar@MDTopAppBar>:
    title: ""
    type: "small"
    MDTopAppBarLeadingButtonContainer:
        MDActionTopAppBarButton:
            icon: "arrow-left"
            on_release: app.back()
    MDTopAppBarTitle:
        text: root.title
    MDTopAppBarTrailingButtonContainer:


# ==========================================================================
#  Pantallas
# ==========================================================================

MDScreenManager:
    LoginScreen:
    RegisterScreen:
    ReaderHomeScreen:
    BookSearchScreen:
    CreateRequestScreen:
    RequestPublishedScreen:
    ReaderRequestsScreen:
    ReaderRequestDetailScreen:
    OfferDetailScreen:
    OfferAcceptedScreen:
    SellerHomeScreen:
    SellerRequestDetailScreen:
    CreateOfferScreen:
    SellerOffersScreen:
    AdminHomeScreen:
    AdminRequestsScreen:
    AdminUsersScreen:
    AdminOffersScreen:
    AdminActivityScreen:


# ------------------------------------------------------------------ Login
<LoginScreen>:
    name: "login"
    md_bg_color: app.theme_cls.backgroundColor
    MDScrollView:
        Page:
            padding: dp(24), dp(40), dp(24), dp(32)
            spacing: dp(14)
            BrandMark:
            MDLabel:
                text: "BookWho?"
                halign: "center"
                font_style: "Headline"
                role: "medium"
                bold: True
                adaptive_height: True
            Muted:
                text: "Ofrece, busca, vende e intercambia."
                halign: "center"
            Widget:
                size_hint_y: None
                height: dp(8)
            MDTextField:
                id: email
                mode: "outlined"
                write_tab: False
                MDTextFieldLeadingIcon:
                    icon: "email-outline"
                MDTextFieldHintText:
                    text: "Correo"
            MDTextField:
                id: password
                mode: "outlined"
                password: True
                write_tab: False
                on_text_validate: root.do_login()
                MDTextFieldLeadingIcon:
                    icon: "lock-outline"
                MDTextFieldHintText:
                    text: "Contraseña"
            PrimaryButton:
                on_release: root.do_login()
                MDButtonText:
                    text: "Iniciar sesión"
            MDBoxLayout:
                adaptive_height: True
                MDButton:
                    style: "text"
                    on_release: app.go("register")
                    MDButtonText:
                        text: "Crear cuenta"
                Widget:
                MDButton:
                    style: "text"
                    on_release: root.forgot_password()
                    MDButtonText:
                        text: "¿Olvidaste tu contraseña?"
            Panel:
                Heading:
                    text: "Cuentas de demo"
                    role: "small"
                Muted:
                    text: "Toca una para completar los datos."
                    role: "small"
                MDListItem:
                    on_release: root.fill_demo("lector@demo.cl", "1234")
                    MDListItemLeadingIcon:
                        icon: "account-search-outline"
                    MDListItemHeadlineText:
                        text: "Lector · Juan Pérez"
                    MDListItemSupportingText:
                        text: "lector@demo.cl  /  1234"
                MDListItem:
                    on_release: root.fill_demo("vendedor@demo.cl", "1234")
                    MDListItemLeadingIcon:
                        icon: "storefront-outline"
                    MDListItemHeadlineText:
                        text: "Vendedor · Librería Los Andes"
                    MDListItemSupportingText:
                        text: "vendedor@demo.cl  /  1234"
                MDListItem:
                    on_release: root.fill_demo("admin@demo.cl", "admin")
                    MDListItemLeadingIcon:
                        icon: "shield-account-outline"
                    MDListItemHeadlineText:
                        text: "Administrador"
                    MDListItemSupportingText:
                        text: "admin@demo.cl  /  admin"


# --------------------------------------------------------------- Registro
<RegisterScreen>:
    name: "register"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Crear cuenta"
        MDScrollView:
            Page:
                padding: dp(24), dp(16), dp(24), dp(32)
                MDTextField:
                    id: name
                    mode: "outlined"
                    write_tab: False
                    MDTextFieldLeadingIcon:
                        icon: "account-outline"
                    MDTextFieldHintText:
                        text: "Nombre"
                MDTextField:
                    id: email
                    mode: "outlined"
                    write_tab: False
                    MDTextFieldLeadingIcon:
                        icon: "email-outline"
                    MDTextFieldHintText:
                        text: "Correo"
                MDTextField:
                    id: password
                    mode: "outlined"
                    password: True
                    write_tab: False
                    MDTextFieldLeadingIcon:
                        icon: "lock-outline"
                    MDTextFieldHintText:
                        text: "Contraseña"
                    MDTextFieldHelperText:
                        text: "Mínimo 4 caracteres"
                        mode: "persistent"
                FieldLabel:
                    text: "¿Cómo usarás la app?"
                SegmentedRow:
                    id: role
                    options: [(Role.READER, "Busco libros (Lector)"), (Role.SELLER, "Vendo libros (Vendedor)")]
                    value: Role.READER
                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(4)
                    size_hint_y: None
                    height: self.minimum_height if role.value == Role.SELLER else 0
                    opacity: 1 if role.value == Role.SELLER else 0
                    disabled: role.value != Role.SELLER
                    FieldLabel:
                        text: "Tu comuna (para que los lectores vean qué tan cerca estás)"
                    MDTextField:
                        id: location
                        mode: "outlined"
                        on_text: root.on_location_text(self.text)
                        MDTextFieldLeadingIcon:
                            icon: "map-marker-outline"
                        MDTextFieldHintText:
                            text: "Ej: Concepción, Santiago, Valparaíso…"
                    ListBox:
                        id: suggestions_box
                Muted:
                    text: "Las cuentas de administrador no se pueden crear desde aquí."
                    role: "small"
                PrimaryButton:
                    on_release: root.do_register()
                    MDButtonText:
                        text: "Crear cuenta"


# ========================================================================
#  LECTOR
# ========================================================================
<ReaderHomeScreen>:
    name: "reader_home"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                markup: True
                text: "BookWho[color=" + hexstr(app.theme_cls.primaryColor) + "]?[/color]"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "format-list-bulleted"
                    on_release: app.go("reader_requests")
                MDActionTopAppBarButton:
                    icon: "logout"
                    on_release: app.logout()
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(20), dp(28), dp(20), dp(32)
                MDLabel:
                    text: "Hola, " + app.user_name
                    font_style: "Body"
                    role: "medium"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(MUTED)
                Gap:
                    height: dp(6)
                MDLabel:
                    text: "¿Qué libro estás buscando?"
                    font_style: "Headline"
                    role: "medium"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(INK)
                Gap:
                    height: dp(8)
                MDLabel:
                    text: "Publica tu búsqueda y los vendedores te enviarán ofertas."
                    font_style: "Body"
                    role: "medium"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(MUTED)
                Gap:
                    height: dp(20)
                SegmentedRow:
                    id: mode
                    options: [("titulo", "Título"), ("autor", "Autor"), ("isbn", "ISBN")]
                    value: "titulo"
                Gap:
                    height: dp(12)
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    MDTextField:
                        id: query
                        mode: "outlined"
                        on_text_validate: root.search()
                        MDTextFieldLeadingIcon:
                            icon: "magnify"
                        MDTextFieldHintText:
                            text: {"titulo": "Título del libro", "autor": "Nombre del autor", "isbn": "ISBN"}.get(mode.value, "")
                    MDButton:
                        style: "filled"
                        theme_height: "Custom"
                        height: query.height
                        radius: [dp(6)] * 4
                        pos_hint: {"center_y": .5}
                        on_release: root.search()
                        MDButtonText:
                            text: "Buscar"
                Gap:
                    height: dp(28)
                MDGridLayout:
                    cols: 2
                    adaptive_height: True
                    canvas.before:
                        Color:
                            rgba: hex(RULE)
                        Line:
                            points: [self.x, self.top, self.right, self.top]
                        Line:
                            points: [self.x, self.y, self.right, self.y]
                        Line:
                            points: [self.center_x, self.y, self.center_x, self.top]
                    StatLink:
                        id: stat_active
                        label: "Solicitudes activas"
                        padding: 0, dp(16), dp(16), dp(16)
                        on_release: app.go("reader_requests")
                    StatLink:
                        id: stat_offers
                        label: "Ofertas por revisar"
                        padding: dp(16), dp(16), 0, dp(16)
                        on_release: app.go("reader_requests")
                Gap:
                    height: dp(20)
                MDBoxLayout:
                    adaptive_height: True
                    MDLabel:
                        text: "Solicitudes recientes"
                        font_style: "Title"
                        role: "large"
                        adaptive_height: True
                        pos_hint: {"center_y": .5}
                    MDButton:
                        style: "text"
                        pos_hint: {"center_y": .5}
                        on_release: app.go("reader_requests")
                        MDButtonText:
                            text: "Ver todas"
                ListBox:
                    id: recent_list


<BookSearchScreen>:
    name: "book_search"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Buscar libro"
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            MDTextField:
                id: query
                mode: "outlined"
                on_text_validate: root.search()
                MDTextFieldLeadingIcon:
                    icon: "magnify"
                MDTextFieldHintText:
                    text: "Título, autor o ISBN"
            SegmentedRow:
                id: mode
                options: [("titulo", "Título"), ("autor", "Autor"), ("isbn", "ISBN")]
                value: "titulo"
            PrimaryButton:
                disabled: root.searching
                on_release: root.search()
                MDButtonText:
                    text: "Buscar"
            MDBoxLayout:
                adaptive_height: True
                spacing: dp(8)
                MDCircularProgressIndicator:
                    size_hint: None, None
                    size: dp(18), dp(18)
                    line_width: dp(2)
                    active: root.searching
                    opacity: 1 if root.searching else 0
                Muted:
                    text: root.status_text
                    role: "small"
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: results


<CreateRequestScreen>:
    name: "create_request"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Crear solicitud"
        MDScrollView:
            Page:
                BookHeader:
                    height: max(dp(124), header_content.minimum_height + dp(32))
                    BookCover:
                        id: cover
                        pos_hint: {"top": 1}
                    MDBoxLayout:
                        id: header_content
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(4)
                        pos_hint: {"top": 1}
                        Muted:
                            text: "Libro seleccionado"
                            font_style: "Label"
                        Heading:
                            id: book_title
                        Muted:
                            id: book_meta
                            role: "small"
                FieldLabel:
                    text: "Precio máximo (opcional)"
                MDTextField:
                    id: max_price
                    mode: "outlined"
                    input_filter: "int"
                    MDTextFieldLeadingIcon:
                        icon: "currency-usd"
                    MDTextFieldHintText:
                        text: "Ej: 15000"
                    MDTextFieldHelperText:
                        text: "Déjalo vacío si no tienes un máximo"
                        mode: "persistent"
                FieldLabel:
                    text: "¿En qué estado lo aceptas?"
                SegmentedRow:
                    id: condition
                    options: [(Condition.ANY, "Cualquiera"), (Condition.NEW, "Nuevo"), (Condition.USED, "Usado")]
                    value: Condition.ANY
                FieldLabel:
                    text: "Ubicación (Ciudad o Comuna)"
                MDTextField:
                    id: location
                    mode: "outlined"
                    on_text: root.on_location_text(self.text)
                    MDTextFieldLeadingIcon:
                        icon: "map-marker-outline"
                    MDTextFieldHintText:
                        text: "Ej: Concepción, Santiago, Valparaíso…"
                    MDTextFieldHelperText:
                        text: "Escribe para buscar tu comuna o ciudad"
                        mode: "persistent"
                ListBox:
                    id: suggestions_box
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(6)
                    padding: 0, dp(4), 0, 0
                    Muted:
                        text: "Rápido:"
                        adaptive_width: True
                        font_style: "Label"
                        role: "small"
                        pos_hint: {"center_y": .5}
                    MDButton:
                        theme_width: "Custom"
                        size_hint_x: 1
                        style: "outlined"
                        size_hint_y: None
                        height: dp(48)
                        radius: [dp(6)] * 4
                        on_release: root.select_location("Concepción (Biobío)")
                        MDButtonText:
                            text: "Concepción"
                    MDButton:
                        theme_width: "Custom"
                        size_hint_x: 1
                        style: "outlined"
                        size_hint_y: None
                        height: dp(48)
                        radius: [dp(6)] * 4
                        on_release: root.select_location("Santiago (Metropolitana)")
                        MDButtonText:
                            text: "Santiago"
                    MDButton:
                        theme_width: "Custom"
                        size_hint_x: 1
                        style: "outlined"
                        size_hint_y: None
                        height: dp(48)
                        radius: [dp(6)] * 4
                        on_release: root.select_location("Valparaíso (Valparaíso)")
                        MDButtonText:
                            text: "Valparaíso"
                FieldLabel:
                    text: "Preferencia de entrega"
                SegmentedRow:
                    id: delivery
                    options: [(Delivery.IN_PERSON, "Presencial"), (Delivery.SHIPPING, "Envío"), (Delivery.ANY, "Cualquiera")]
                    value: Delivery.ANY
                FieldLabel:
                    text: "Notas (opcional)"
                MDTextField:
                    id: notes
                    mode: "outlined"
                    multiline: True
                    max_height: dp(140)
                    MDTextFieldHintText:
                        text: "Edición, idioma, detalles…"
                Widget:
                    size_hint_y: None
                    height: dp(4)
                PrimaryButton:
                    on_release: root.publish()
                    MDButtonIcon:
                        icon: "send"
                    MDButtonText:
                        text: "PUBLICAR SOLICITUD"


<RequestPublishedScreen>:
    name: "request_published"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        MDBoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: 0, dp(4), dp(8), 0
            Widget:
            MDIconButton:
                icon: "close"
                pos_hint: {"center_y": .5}
                theme_icon_color: "Custom"
                icon_color: hex(INK)
                on_release: app.go_home()
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(22), dp(18), dp(22), dp(16)
                MDAnchorLayout:
                    size_hint: None, None
                    size: dp(56), dp(56)
                    radius: [dp(28)] * 4
                    line_color: app.theme_cls.primaryColor
                    line_width: dp(1)
                    MDIcon:
                        icon: "check"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primaryColor
                Gap:
                    height: dp(24)
                MDLabel:
                    id: request_id
                    font_style: "Label"
                    role: "large"
                    bold: True
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(FAINT)
                Gap:
                    height: dp(8)
                MDLabel:
                    text: "Tu solicitud está publicada"
                    font_style: "Headline"
                    role: "large"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(INK)
                Gap:
                    height: dp(8)
                MDLabel:
                    text: "Los vendedores ya pueden verla y enviarte ofertas."
                    font_style: "Body"
                    role: "large"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(MUTED)
                Gap:
                    height: dp(24)
                Rule:
                ListBox:
                    id: request_row
                Gap:
                    height: dp(28)
                MDLabel:
                    text: "QUÉ SIGUE"
                    font_style: "Label"
                    role: "large"
                    bold: True
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(INK)
                Gap:
                    height: dp(8)
                NextStep:
                    number: "1"
                    text: "Los vendedores que tengan el libro te envían una oferta."
                NextStep:
                    number: "2"
                    text: "Comparas precio, estado y ubicación, y aceptas una."
                NextStep:
                    number: "3"
                    text: "Ves los datos de contacto del vendedor para coordinar."
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(22), dp(8), dp(22), dp(24)
            spacing: dp(10)
            WideButton:
                style: "filled"
                radius: [dp(6)] * 4
                on_release: app.open_reader_request(app.current_request_id)
                MDButtonText:
                    text: "Ver solicitud"
            WideButton:
                style: "outlined"
                radius: [dp(6)] * 4
                on_release: app.go_home()
                MDButtonText:
                    text: "Volver al inicio"


<ReaderRequestsScreen>:
    name: "reader_requests"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Mis solicitudes"
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            SegmentedRow:
                id: filter
                options: [("todas", "Todas"), ("activas", "Activas"), ("resueltas", "Resueltas"), ("canceladas", "Canceladas")]
                value: "todas"
                on_value: root.refresh()
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list


<ReaderRequestDetailScreen>:
    name: "reader_request_detail"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Detalle de solicitud"
        MDScrollView:
            Page:
                BookHeader:
                    height: max(dp(124), header_content.minimum_height + dp(32))
                    BookCover:
                        id: cover
                        pos_hint: {"top": 1}
                    MDBoxLayout:
                        id: header_content
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(6)
                        pos_hint: {"top": 1}
                        Heading:
                            id: book_title
                        Muted:
                            id: book_meta
                            role: "small"
                        StatusChip:
                            id: status
                            kind: "request"
                Panel:
                    spacing: dp(2)
                    ListBox:
                        id: info
                        spacing: dp(2)
                Heading:
                    id: offers_title
                ListBox:
                    id: offers
                WideButton:
                    style: "outlined"
                    height: dp(48) if root.can_cancel else 0
                    opacity: 1 if root.can_cancel else 0
                    disabled: not root.can_cancel
                    on_release: root.cancel()
                    MDButtonText:
                        text: "Cancelar solicitud"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.errorColor


<OfferDetailScreen>:
    name: "offer_detail"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Detalle de oferta"
        MDScrollView:
            Page:
                Panel:
                    Muted:
                        id: book_title
                        font_style: "Title"
                        role: "small"
                        text_color: hex(MUTED)
                    MDLabel:
                        id: price
                        font_style: "Display"
                        role: "small"
                        bold: True
                        adaptive_height: True
                        theme_text_color: "Custom"
                        text_color: hex(INK)
                    StatusChip:
                        id: status
                        kind: "offer"
                Panel:
                    spacing: dp(2)
                    ListBox:
                        id: info
                        spacing: dp(2)
                Panel:
                    md_bg_color: hex(TRACK)
                    opacity: 1 if root.can_accept else 0
                    height: self.minimum_height if root.can_accept else 0
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "shield-lock-outline"
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            text: "Los datos de contacto del vendedor se mostrarán cuando aceptes la oferta para coordinar."
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
                Panel:
                    md_bg_color: hex(TRACK)
                    opacity: 1 if root.in_deal else 0
                    height: self.minimum_height if root.in_deal else 0
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "handshake-outline"
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            text: "Oferta en coordinación. Comunícate con el vendedor mediante sus datos de contacto."
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
                Panel:
                    md_bg_color: hex(TRACK)
                    opacity: 1 if root.on_hold else 0
                    height: self.minimum_height if root.on_hold else 0
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "clock-outline"
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            text: "Esta oferta está en espera mientras el lector coordina con otra oferta. Si no se concreta, se reactivará."
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
                PrimaryButton:
                    opacity: 1 if root.can_accept else 0
                    disabled: not root.can_accept
                    height: dp(52) if root.can_accept else 0
                    on_release: root.accept()
                    MDButtonIcon:
                        icon: "handshake-outline"
                    MDButtonText:
                        text: "ACEPTAR PARA COORDINAR"
                PrimaryButton:
                    opacity: 1 if (root.in_deal or root.accepted) else 0
                    disabled: not (root.in_deal or root.accepted)
                    height: dp(52) if (root.in_deal or root.accepted) else 0
                    on_release: app.go("offer_accepted")
                    MDButtonIcon:
                        icon: "card-account-phone-outline"
                    MDButtonText:
                        text: "Ver datos de contacto"
                PrimaryButton:
                    opacity: 1 if (root.in_deal and root.is_reader) else 0
                    disabled: not (root.in_deal and root.is_reader)
                    height: dp(52) if (root.in_deal and root.is_reader) else 0
                    on_release: root.confirm_deal()
                    MDButtonIcon:
                        icon: "check-circle-outline"
                    MDButtonText:
                        text: "CONFIRMAR COMPRA CONCRETADA"
                WideButton:
                    style: "outlined"
                    opacity: 1 if (root.in_deal and root.is_reader) else 0
                    disabled: not (root.in_deal and root.is_reader)
                    height: dp(48) if (root.in_deal and root.is_reader) else 0
                    on_release: root.cancel_deal()
                    MDButtonText:
                        text: "Desistir del trato"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.errorColor


<OfferAcceptedScreen>:
    name: "offer_accepted"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Oferta aceptada"
        MDScrollView:
            Page:
                padding: dp(16), dp(24), dp(16), dp(32)
                spacing: dp(14)
                MDIcon:
                    icon: "handshake"
                    font_size: "64sp"
                    pos_hint: {"center_x": .5}
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.primaryColor
                MDLabel:
                    text: "¡Oferta aceptada!"
                    halign: "center"
                    font_style: "Headline"
                    role: "medium"
                    bold: True
                    adaptive_height: True
                Muted:
                    id: summary
                    halign: "center"
                Panel:
                    Heading:
                        text: "Contacto del vendedor"
                        role: "small"
                    ListBox:
                        id: contact
                        spacing: dp(2)
                Panel:
                    md_bg_color: hex(TRACK)
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "information-outline"
                            pos_hint: {"top": 1}
                            theme_text_color: "Custom"
                            text_color: hex(INK)
                        MDLabel:
                            text: "La compra y la entrega se coordinan directamente entre tú y el vendedor. La app no procesa pagos ni envíos."
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
                            theme_text_color: "Custom"
                            text_color: hex(INK)
                PrimaryButton:
                    on_release: app.go_home()
                    MDButtonText:
                        text: "Volver al inicio"


# ========================================================================
#  VENDEDOR
# ========================================================================
<SellerHomeScreen>:
    name: "seller_home"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                text: "Solicitudes disponibles"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "tag-multiple-outline"
                    on_release: app.go("seller_offers")
                MDActionTopAppBarButton:
                    icon: "logout"
                    on_release: app.logout()
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            Muted:
                text: "Hola, " + app.user_name + ". No publicas libros: elige una solicitud abierta y ofrécele el libro que buscan."
            Panel:
                MDTextField:
                    id: text
                    mode: "outlined"
                    on_text: root.refresh()
                    MDTextFieldLeadingIcon:
                        icon: "magnify"
                    MDTextFieldHintText:
                        text: "Buscar por título, autor o ISBN"
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(10)
                    MDTextField:
                        id: location
                        mode: "outlined"
                        on_text: root.refresh()
                        MDTextFieldLeadingIcon:
                            icon: "map-marker-outline"
                        MDTextFieldHintText:
                            text: "Ubicación"
                    MDTextField:
                        id: budget
                        mode: "outlined"
                        input_filter: "int"
                        on_text: root.refresh()
                        MDTextFieldLeadingIcon:
                            icon: "cash"
                        MDTextFieldHintText:
                            text: "Presup. mín."
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    SegmentedRow:
                        id: condition
                        options: [("todas", "Todas"), (Condition.NEW, "Nuevo"), (Condition.USED, "Usado")]
                        value: "todas"
                        on_value: root.refresh()
                    MDIconButton:
                        icon: "filter-remove-outline"
                        pos_hint: {"center_y": .5}
                        on_release: root.clear_filters()
            Muted:
                id: count
                role: "small"
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list


<SellerRequestDetailScreen>:
    name: "seller_request_detail"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Solicitud"
        MDScrollView:
            Page:
                BookHeader:
                    height: max(dp(124), header_content.minimum_height + dp(32))
                    BookCover:
                        id: cover
                        pos_hint: {"top": 1}
                    MDBoxLayout:
                        id: header_content
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(6)
                        pos_hint: {"top": 1}
                        Heading:
                            id: book_title
                        Muted:
                            id: book_meta
                            role: "small"
                        StatusChip:
                            id: status
                            kind: "request"
                Panel:
                    spacing: dp(2)
                    ListBox:
                        id: info
                        spacing: dp(2)
                Panel:
                    md_bg_color: hex(TRACK)
                    opacity: 1 if root.offer_note else 0
                    height: self.minimum_height if root.offer_note else 0
                    MDLabel:
                        text: root.offer_note
                        font_style: "Body"
                        role: "medium"
                        adaptive_height: True
                PrimaryButton:
                    opacity: 1 if root.can_offer else 0
                    disabled: not root.can_offer
