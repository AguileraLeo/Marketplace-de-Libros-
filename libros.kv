# ========================================================================
#  ADMINISTRADOR
# ========================================================================
<AdminHomeScreen>:
    name: "admin_home"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                text: "Administración"
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "refresh"
                    on_release: root.refresh()
                MDActionTopAppBarButton:
                    icon: "logout"
                    on_release: app.logout()
        MDScrollView:
            Page:
                MDGridLayout:
                    cols: 3
                    spacing: dp(10)
                    adaptive_height: True
                    StatTile:
                        id: st_usuarios
                        label: "Usuarios"
                        icon: "account-group-outline"
                    StatTile:
                        id: st_lectores
                        label: "Lectores"
                        icon: "account-search-outline"
                    StatTile:
                        id: st_vendedores
                        label: "Vendedores"
                        icon: "storefront-outline"
                    StatTile:
                        id: st_solicitudes
                        label: "Solicitudes"
                        icon: "file-document-outline"
                    StatTile:
                        id: st_activas
                        label: "Activas"
                        icon: "flash-outline"
                    StatTile:
                        id: st_con_ofertas
                        label: "Con ofertas"
                        icon: "tag-outline"
                    StatTile:
                        id: st_resueltas
                        label: "Resueltas"
                        icon: "check-decagram-outline"
                    StatTile:
                        id: st_canceladas
                        label: "Canceladas"
                        icon: "close-circle-outline"
                    StatTile:
                        id: st_ofertas
                        label: "Ofertas"
                        icon: "handshake-outline"
                Heading:
                    text: "Gestión"
                    role: "small"
                Panel:
                    spacing: dp(2)
                    MDListItem:
                        on_release: app.go("admin_requests")
                        MDListItemLeadingIcon:
                            icon: "clipboard-text-outline"
                        MDListItemHeadlineText:
                            text: "Solicitudes"
                        MDListItemSupportingText:
                            text: "Ver, filtrar y moderar solicitudes"
                    MDListItem:
                        on_release: app.go("admin_users")
                        MDListItemLeadingIcon:
                            icon: "account-multiple-outline"
                        MDListItemHeadlineText:
                            text: "Usuarios"
                        MDListItemSupportingText:
                            text: "Consultar y suspender usuarios"
                    MDListItem:
                        on_release: app.go("admin_offers")
                        MDListItemLeadingIcon:
                            icon: "tag-multiple-outline"
                        MDListItemHeadlineText:
                            text: "Ofertas"
                        MDListItemSupportingText:
                            text: "Historial de ofertas de la plataforma"
                    MDListItem:
                        on_release: app.go("admin_activity")
                        MDListItemLeadingIcon:
                            icon: "history"
                        MDListItemHeadlineText:
                            text: "Auditoría / Actividad"
                        MDListItemSupportingText:
                            text: "Buscar y exportar logs de actividad"


<AdminRequestsScreen>:
    name: "admin_requests"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Solicitudes"
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            SegmentedRow:
                id: filter
                options: [("todas", "Todas"), ("activas", "Activas"), ("resueltas", "Resueltas"), ("canceladas", "Canceladas")]
                value: "todas"
                on_value: root.refresh()
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list


<AdminUsersScreen>:
    name: "admin_users"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Usuarios"
        MDScrollView:
            Page:
                padding: dp(16), dp(12), dp(16), dp(32)
                ListBox:
                    id: list


<AdminOffersScreen>:
    name: "admin_offers"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Ofertas"
        MDScrollView:
            Page:
                padding: dp(16), dp(12), dp(16), dp(32)
                ListBox:
                    id: list


<AdminActivityScreen>:
    name: "admin_activity"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: "Auditoría / Actividad"
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            MDTextField:
                id: search
                mode: "outlined"
                on_text: root.refresh()
                MDTextFieldLeadingIcon:
                    icon: "magnify"
                MDTextFieldHintText:
                    text: "Buscar por acción, detalle o actor"
            PrimaryButton:
                on_release: root.export_logs()
                MDButtonIcon:
                    icon: "download"
                MDButtonText:
                    text: "Exportar logs de actividad"
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list
