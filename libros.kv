                MDTextField:
                    id: notes
                    mode: "outlined"
                    multiline: True
                    max_height: dp(120)
                    MDTextFieldHintText:
                        text: "Información adicional (opcional)"
                MDDivider:
                FieldLabel:
                    text: "Datos de contacto"
