#:kivy 2.3.0
#:import dp kivy.metrics.dp
#:import Role models.store.Role
#:import Condition models.store.Condition
#:import Delivery models.store.Delivery
#:import hex kivy.utils.get_color_from_hex
#:import hexstr kivy.utils.get_hex_from_color
#:import sp kivy.metrics.sp
#:import UI views.components
#:set INK UI.INK
#:set MUTED UI.MUTED
#:set FAINT UI.MUTED
#:set RULE UI.RULE
#:set FIELD_LINE UI.RULE
#:set TRACK UI.SOFT


# ==========================================================================
#  Componentes reutilizables
# ==========================================================================

<Heading@MDLabel>:
    font_style: "Title"
    role: "medium"
    bold: True
    adaptive_height: True

<Muted@MDLabel>:
    font_style: "Body"
    role: "medium"
    adaptive_height: True
    theme_text_color: "Custom"
    text_color: app.theme_cls.onSurfaceVariantColor

<FieldLabel@MDLabel>:
    font_style: "Label"
    role: "large"
    bold: True
    adaptive_height: True
    padding: 0, dp(6), 0, 0

<WideButton>:
    theme_width: "Custom"
    size_hint_x: 1
    height: dp(48)
    radius: [dp(12)] * 4

<PrimaryButton@WideButton>:
    style: "filled"
    height: dp(52)

# El hinting "normal" de Kivy abre huecos dentro de palabras en Source Serif ("ofer tas").
<MDLabel>:
    text_color: hex(app.ui_palette["ink"])
    theme_text_color: "Custom"
    font_hinting: None
    font_kerning: True

<MDButtonText>:
    theme_text_color: "Custom"
    text_color: app.theme_cls.onPrimaryColor if self.parent and self.parent.style == "filled" else app.theme_cls.primaryColor

<MDButtonIcon>:
    theme_text_color: "Custom"
    text_color: app.theme_cls.onPrimaryColor if self.parent and self.parent.style == "filled" else app.theme_cls.primaryColor

<MDTextField>:
    theme_bg_color: "Custom"
    fill_color_normal: hex(app.ui_palette["surface"])
    fill_color_focus: hex(app.ui_palette["surface"])
    radius: [dp(12)] * 4
    theme_line_color: "Custom"
    line_color_normal: hex(app.ui_palette["rule"])
    line_color_focus: app.theme_cls.primaryColor

<MDTextFieldHintText>:
    text_color_normal: hex(app.ui_palette["muted"])
    text_color_focus: app.theme_cls.primaryColor

# KivyMD aplica el color de estas texturas en el canvas del campo.
<BaseTextFieldLabel>:
    text_color: 1, 1, 1, 1

<BaseTextFieldIcon>:
    text_color: 1, 1, 1, 1

<MDTopAppBar>:
    theme_bg_color: "Custom"
    md_bg_color: app.theme_cls.backgroundColor

<Page@MDBoxLayout>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(24), dp(16), dp(24), dp(32)
    spacing: dp(16)

<Panel@MDCard>:
    style: "filled"
    theme_bg_color: "Custom"
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(16)
    spacing: dp(10)
    radius: [dp(16)] * 4
    ripple_effect: False
    md_bg_color: hex(app.ui_palette["surface"])
    line_color: hex(app.ui_palette["rule"])

<Gap@Widget>:
    size_hint_y: None
    height: dp(12)

<Rule@Widget>:
    size_hint_y: None
    height: dp(1)
    canvas:
        Color:
            rgba: hex(app.ui_palette["rule"])
        Rectangle:
            pos: self.pos
            size: self.size

<NextStep@MDBoxLayout>:
    number: ""
    text: ''
    adaptive_height: True
    padding: 0, dp(10)
    MDLabel:
        text: root.number
        size_hint_x: None
        width: dp(30)
        font_style: "Title"
        role: "medium"
        adaptive_height: True
        pos_hint: {"top": 1}
        theme_text_color: "Custom"
        text_color: app.theme_cls.primaryColor
    MDLabel:
        text: root.text
        font_style: "Body"
        role: "large"
        adaptive_height: True
        pos_hint: {"top": 1}
        theme_text_color: "Custom"
        text_color: hex(app.ui_palette["ink"])

<SegmentedRow>:
    adaptive_height: True
    spacing: dp(8)
    md_bg_color: 0, 0, 0, 0

<SegmentButton>:
    size_hint_y: None
    height: dp(48)
    radius: [dp(24)] * 4
    md_bg_color: hex(app.ui_palette["soft"]) if self.selected else (0, 0, 0, 0)
    MDLabel:
        text: root.text
        halign: "center"
        font_style: "Body"
        role: "medium"
        bold: root.selected
        theme_text_color: "Custom"
        text_color: app.theme_cls.primaryColor if root.selected else hex(app.ui_palette["muted"])

<StatLink@ButtonBehavior+MDBoxLayout>:
    value: "0"
    label: ''
    highlight: False
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(2)
    MDLabel:
        text: ('0' if len(root.value) == 1 else '') + root.value
        font_style: "Headline"
        role: "medium"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: app.theme_cls.primaryColor
    MDLabel:
        text: root.label
        font_style: "Body"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: hex(app.ui_palette["muted"])

<RequestRow>:
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(16)
    spacing: dp(12)
    radius: [dp(16)] * 4
    md_bg_color: hex(app.ui_palette["surface"])
    line_color: hex(app.ui_palette["rule"])
    on_release: root.callback(root) if root.callback else None
    MDBoxLayout:
        size_hint_y: None
        height: max(dp(92), info.minimum_height)
        spacing: dp(16)
        BookCover:
            source: root.cover
            size: dp(64), dp(92)
            pos_hint: {"top": 1}
        MDBoxLayout:
            id: info
            orientation: "vertical"
            adaptive_height: True
            spacing: dp(5)
            pos_hint: {"top": 1}
            MDLabel:
                text: root.title
                font_style: "Title"
                role: "medium"
                bold: True
                adaptive_height: True
            Muted:
                text: root.author
                role: "small"
            Muted:
                text: root.meta
                role: "small"
            MDLabel:
                text: root.price
                markup: True
                font_style: "Body"
                role: "medium"
                adaptive_height: True
                text_color: app.theme_cls.primaryColor
    MDBoxLayout:
        adaptive_height: True
        spacing: dp(8)
        StatusChip:
            status: root.status
            kind: "request"
        MDLabel:
            text: root.detail
            font_style: "Body"
            role: "small"
            adaptive_height: True
            pos_hint: {"center_y": .5}
            text_color: hex(app.ui_palette["muted"])

<ListBox@MDBoxLayout>:
    orientation: "vertical"
    adaptive_height: True
    spacing: dp(12)

<BookCover>:
    size_hint: None, None
    size: dp(64), dp(92)
    md_bg_color: hex(app.ui_palette["soft"])
    radius: [dp(3)] * 4
    MDIcon:
        icon: "book-open-page-variant"
        pos_hint: {"center_x": .5, "center_y": .5}
        theme_text_color: "Custom"
        text_color: hex(app.ui_palette["muted"])
    Image:
        source: root.local_source
        fit_mode: "cover"
        opacity: 1 if root.loaded and root.local_source else 0

<StatusChip>:
    adaptive_size: True
    spacing: dp(6)
    padding: dp(10), dp(6)
    radius: [dp(16)] * 4
    md_bg_color: root.bg
    pos_hint: {"center_y": .5}
    Widget:
        size_hint: None, None
        size: dp(7), dp(7)
        pos_hint: {"center_y": .5}
        canvas:
            Color:
                rgba: root.dot
            Ellipse:
                pos: self.pos
                size: self.size
    MDLabel:
        text: app.ui_text(root.text, app.language) or ' '
        adaptive_size: True
        font_style: "Body"
        role: "small"
        bold: True
        theme_text_color: "Custom"
        text_color: root.fg

<ItemCard>:
    style: "filled"
    theme_bg_color: "Custom"
    md_bg_color: hex(app.ui_palette["surface"])
    line_color: hex(app.ui_palette["rule"])
    orientation: "vertical"
    size_hint_y: None
    height: self.minimum_height
    padding: dp(16)
    spacing: dp(2)
    radius: [dp(14)] * 4
    ripple_effect: False
    on_release: root.callback(root) if root.callback else None
    MDBoxLayout:
        adaptive_height: True
        spacing: dp(12)
        MDLabel:
            text: root.title
            font_style: "Title"
            role: "medium"
            adaptive_height: True
            pos_hint: {"center_y": .5}
            theme_text_color: "Custom"
            text_color: hex(app.ui_palette["ink"])
        StatusChip:
            status: root.status
            kind: root.kind
            opacity: 1 if root.status else 0
    MDLabel:
        text: root.subtitle
        font_style: "Body"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: hex(app.ui_palette["muted"])
    MDLabel:
        text: root.meta
        font_style: "Body"
        role: "small"
        adaptive_height: True
        theme_text_color: "Custom"
        text_color: hex(app.ui_palette["muted"])
    MDBoxLayout:
        size_hint_y: None
        height: dp(48) if root.action_text else 0
        opacity: 1 if root.action_text else 0
        disabled: not root.action_text
        Widget:
        MDButton:
            style: "text"
            on_release: root.action_callback(root) if root.action_callback else None
            MDButtonText:
                text: root.action_text
                theme_text_color: "Custom"
                text_color: app.theme_cls.errorColor if root.action_text.startswith(("Cancelar", "Suspender", "Desistir")) else app.theme_cls.primaryColor

<BookResultCard>:
    style: "filled"
    theme_bg_color: "Custom"
    md_bg_color: hex(app.ui_palette["surface"])
    line_color: hex(app.ui_palette["rule"])
    orientation: "horizontal"
    size_hint_y: None
    height: max(dp(92), content.minimum_height) + dp(32)
    padding: dp(16)
    spacing: dp(14)
    radius: [dp(14)] * 4
    ripple_effect: False
    BookCover:
        source: root.cover
        size: dp(64), dp(92)
        pos_hint: {"top": 1}
    MDBoxLayout:
        id: content
        orientation: "vertical"
        adaptive_height: True
        spacing: dp(2)
        pos_hint: {"top": 1}
        MDLabel:
            text: root.title
            font_style: "Title"
            role: "medium"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(app.ui_palette["ink"])
        MDLabel:
            text: root.subtitle
            font_style: "Body"
            role: "small"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(app.ui_palette["muted"])
        MDLabel:
            text: root.meta
            font_style: "Body"
            role: "small"
            adaptive_height: True
            theme_text_color: "Custom"
            text_color: hex(app.ui_palette["muted"])
        MDBoxLayout:
            adaptive_height: True
            padding: 0, dp(6), 0, 0
            Widget:
            MDButton:
                style: "outlined"
                radius: [dp(12)] * 4
                on_release: app.select_book(root.book)
                MDButtonText:
                    text: app.ui_text('Seleccionar', app.language)

<StatTile>:
    style: "filled"
    theme_bg_color: "Custom"
    md_bg_color: hex(app.ui_palette["surface"])
    line_color: hex(app.ui_palette["rule"])
    orientation: "vertical"
    size_hint_y: None
    height: dp(84)
    padding: dp(14), dp(10)
    radius: [dp(12)] * 4
    ripple_effect: False
    MDBoxLayout:
        adaptive_height: True
        MDLabel:
            text: root.value
            font_style: "Headline"
            role: "medium"
            theme_text_color: "Custom"
            text_color: hex(app.ui_palette["ink"])
        Widget:
        MDIcon:
            icon: root.icon
            theme_text_color: "Custom"
            text_color: hex(app.ui_palette["muted"])
            pos_hint: {"center_y": .6}
    MDLabel:
        text: root.label
        font_style: "Body"
        role: "small"
        theme_text_color: "Custom"
        text_color: hex(app.ui_palette["muted"])

<InfoRow>:
    adaptive_height: True
    spacing: dp(12)
    padding: 0, dp(10)
    Muted:
        text: root.label
        size_hint_x: .40
        pos_hint: {"top": 1}
        role: "small"
    MDLabel:
        text: root.value
        size_hint_x: .60
        font_style: "Body"
        role: "medium"
        adaptive_height: True
        bold: True
        pos_hint: {"top": 1}

<EmptyState>:
    orientation: "vertical"
    adaptive_height: True
    padding: dp(16), dp(28)
    spacing: dp(8)
    MDIcon:
        icon: root.icon
        pos_hint: {"center_x": .5}
        theme_text_color: "Custom"
        text_color: app.theme_cls.outlineColor
    Muted:
        text: root.text
        halign: "center"

# Encabezado de libro reutilizado en detalles (ids: cover, book_title, book_meta, status)
<BookHeader@Panel>:
    orientation: "horizontal"
    spacing: dp(14)

# Marca de la app: libro + insignia de interrogación ("¿quién lo tiene?")
<BrandMark@MDRelativeLayout>:
    size_hint: None, None
    size: dp(104), dp(104)
    pos_hint: {"center_x": .5}
    MDCard:
        style: "filled"
        theme_bg_color: "Custom"
        md_bg_color: hex(UI.ACCENT)
        radius: [dp(14)] * 4
        ripple_effect: False
        MDRelativeLayout:
            canvas.after:
                Color:
                    rgba: hex("#F3C66E")
                Line:
                    points: [self.center_x, self.center_y + dp(23), self.center_x, self.center_y - dp(19)]
                    width: dp(1.5)
                    cap: "round"
            MDIcon:
                icon: "book-open-page-variant"
                theme_font_size: "Custom"
                font_size: "68sp"
                pos_hint: {"center_x": .5, "center_y": .5}
                theme_text_color: "Custom"
                text_color: hex("#FFFFFF")

    MDCard:
        style: "filled"
        theme_bg_color: "Custom"
        md_bg_color: hex(UI.PAPER)
        line_color: hex(UI.ACCENT)
        radius: [dp(15)] * 4
        size_hint: None, None
        size: dp(30), dp(30)
        pos_hint: {"right": 1, "y": 0}
        ripple_effect: False
        MDRelativeLayout:
            MDIcon:
                icon: "help"
                theme_font_size: "Custom"
                font_size: "18sp"
                pos_hint: {"center_x": .5, "center_y": .5}
                theme_text_color: "Custom"
                text_color: hex(UI.ACCENT)


# Barra superior con botón "atrás"
<BackBar@MDTopAppBar>:
    title: ''
    type: "small"
    MDTopAppBarLeadingButtonContainer:
        MDActionTopAppBarButton:
            icon: "arrow-left"
            on_release: app.back()
    MDTopAppBarTitle:
        text: root.title
    MDTopAppBarTrailingButtonContainer:



<RoleBadge@MDBoxLayout>:
    text: app.ui_text('Lector', app.language)
    adaptive_size: True
    padding: dp(12), dp(7)
    radius: [dp(18)] * 4
    md_bg_color: hex(app.ui_palette["soft"])
    pos_hint: {"center_y": .5}
    MDLabel:
        text: root.text
        font_style: "Label"
        role: "medium"
        adaptive_size: True
        text_color: app.theme_cls.primaryColor

<HomeHeader@MDBoxLayout>:
    role_text: app.ui_text('Lector', app.language)
    size_hint_y: None
    height: dp(72)
    padding: dp(24), dp(12)
    MDLabel:
        text: 'BookWho?'
        font_style: "Title"
        role: "large"
        bold: True
        adaptive_height: True
        pos_hint: {"center_y": .5}
        text_color: app.theme_cls.primaryColor
    RoleBadge:
        text: root.role_text

<HomeNav@MDBoxLayout>:
    seller: False
    size_hint_y: None
    height: dp(64)
    padding: dp(12), dp(6)
    spacing: dp(4)
    md_bg_color: app.theme_cls.backgroundColor
    MDButton:
        style: "text"
        theme_width: "Custom"
        size_hint_x: 1
        on_release: app.go_home()
        MDButtonText:
            text: app.ui_text('Inicio', app.language)
    MDButton:
        style: "text"
        theme_width: "Custom"
        size_hint_x: 1.6
        on_release: app.go("seller_offers" if root.seller else "reader_requests")
        MDButtonText:
            text: app.ui_text('Mis ofertas', app.language) if root.seller else app.ui_text('Mis solicitudes', app.language)
    MDButton:
        style: "text"
        theme_width: "Custom"
        size_hint_x: 1
        on_release: app.logout()
        MDButtonText:
            text: app.ui_text('Salir', app.language)

# ==========================================================================
#  Pantallas
# ==========================================================================

MDScreenManager:
    LoginScreen:
    RegisterScreen:
    ServiceTermsScreen:
    ReaderHomeScreen:
    BookSearchScreen:
    CreateRequestScreen:
    RequestPublishedScreen:
    ReaderRequestsScreen:
    ReaderRequestDetailScreen:
    OfferDetailScreen:
    OfferAcceptedScreen:
    SellerHomeScreen:
    SellerRequestDetailScreen:
    CreateOfferScreen:
    SellerOffersScreen:
    AdminHomeScreen:
    AdminRequestsScreen:
    AdminUsersScreen:
    AdminOffersScreen:
    AdminActivityScreen:


# ------------------------------------------------------------------ Login
<LoginScreen>:
    name: "login"
    md_bg_color: hex(app.ui_palette["surface"])
    MDScrollView:
        Page:
            padding: dp(24), dp(48), dp(24), dp(32)
            spacing: 0
            BrandMark:
            Gap:
                height: dp(20)
            MDLabel:
                text: 'BookWho?'
                halign: "center"
                font_style: "Headline"
                role: "medium"
                bold: True
                adaptive_height: True
            Gap:
                height: dp(40)
            MDLabel:
                text: app.ui_text('Iniciar sesión', app.language)
                halign: "center"
                font_style: "Title"
                role: "large"
                bold: True
                adaptive_height: True
            MDBoxLayout:
                size_hint_y: None
                height: dp(48)
                spacing: 0
                Widget:
                Muted:
                    text: app.ui_text('¿No tienes cuenta?', app.language)
                    adaptive_size: True
                    role: "small"
                    pos_hint: {"center_y": .5}
                MDButton:
                    style: "text"
                    pos_hint: {"center_y": .5}
                    on_release: app.go("register")
                    MDButtonText:
                        text: app.ui_text('Crear cuenta', app.language)
                Widget:
            Gap:
                height: dp(24)
            FieldLabel:
                text: app.ui_text('Correo electrónico', app.language)
                padding: 0
            Gap:
                height: dp(10)
            MDTextField:
                id: email
                mode: "outlined"
                write_tab: False
                radius: [dp(10)] * 4
                MDTextFieldHintText:
                    text: app.ui_text('tu@correo.cl', app.language)
            Gap:
                height: dp(22)
            FieldLabel:
                text: app.ui_text('Contraseña', app.language)
                padding: 0
            Gap:
                height: dp(10)
            MDTextField:
                id: password
                mode: "outlined"
                password: True
                write_tab: False
                radius: [dp(10)] * 4
                on_text_validate: root.do_login()
                MDTextFieldHintText:
                    text: app.ui_text('Tu contraseña', app.language)
            Gap:
                height: dp(24)
            PrimaryButton:
                height: dp(54)
                radius: [dp(27)] * 4
                on_release: root.do_login()
                MDButtonText:
                    text: app.ui_text('Iniciar sesión', app.language)
            Gap:
                height: dp(30)
            Muted:
                text: app.ui_text('Recuperación de contraseña', app.language)
                halign: "center"
                role: "small"
            Gap:
                height: dp(6)
            Muted:
                text: app.ui_text('Todavía no disponible.', app.language)
                halign: "center"
                role: "small"
            Gap:
                height: dp(40)
            Rule:
                size_hint_x: None
                width: dp(100)
                pos_hint: {"center_x": .5}
            Gap:
                height: dp(20)
            Muted:
                text: app.ui_text('Busca un libro.\nEncuentra quién lo tiene.', app.language)
                halign: "center"
            Gap:
                height: dp(16)
            Muted:
                text: app.ui_text(app.banner, app.language)
                halign: "center"
                role: "small"
            Gap:
                height: dp(24)
            Rule:
            Gap:
                height: dp(8)
            WideButton:
                style: "text"
                on_release: app.show_language_picker()
                MDButtonIcon:
                    icon: "web"
                MDButtonText:
                    text: 'English' if app.language == 'en' else 'Español'
            Muted:
                text: app.ui_text('Idioma de la aplicación', app.language)
                halign: "center"
                role: "small"
            Muted:
                text: 'soporte@quadcorestore.com'
                halign: "center"
                role: "small"
            Muted:
                text: app.ui_text('Correo informativo · aún no habilitado', app.language)
                halign: "center"
                role: "small"
            WideButton:
                style: "text"
                on_release: app.go("service_terms")
                MDButtonText:
                    text: app.ui_text('Condiciones del servicio', app.language)
            Muted:
                text: app.ui_text('BookWho? · Proyecto académico', app.language)
                halign: "center"
                role: "small"


<ServiceTermsScreen>:
    name: "service_terms"
    md_bg_color: hex(app.ui_palette["surface"])
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Condiciones del servicio', app.language)
        MDScrollView:
            Page:
                Heading:
                    text: app.ui_text('Condiciones de BookWho?', app.language)
                Muted:
                    text: app.ui_text('Borrador para revisión del equipo · Prototipo académico', app.language)
                MDLabel:
                    text: app.ui_text('BookWho? conecta lectores que buscan libros con vendedores que pueden ofrecerlos. Una solicitud no garantiza recibir una oferta ni conseguir el libro.', app.language)
                    adaptive_height: True
                Heading:
                    text: app.ui_text('Coordinación entre las partes', app.language)
                MDLabel:
                    text: app.ui_text('Aceptar una oferta inicia la coordinación y permite consultar el contacto autorizado. La compra y la entrega se acuerdan fuera de BookWho?. La aplicación no procesa pagos, no gestiona envíos y no dispone de chat interno.', app.language)
                    adaptive_height: True
                Heading:
                    text: app.ui_text('Datos y acceso', app.language)
                MDLabel:
                    text: app.ui_text('La aplicación guarda datos de cuenta, solicitudes, ofertas, contactos y actividad. Los permisos se comprueban según el rol y la propiedad del recurso. Los datos de contacto se muestran mediante los métodos autorizados al coordinar una oferta. En modo servidor los datos se guardan en el servidor; en modo sin conexión permanecen en el dispositivo.', app.language)
                    adaptive_height: True
                Heading:
                    text: app.ui_text('Límites de esta versión', app.language)
                MDLabel:
                    text: app.ui_text('La recuperación de contraseña no está disponible. El correo soporte@quadcorestore.com se muestra como referencia y aún no está habilitado. No se ofrece inicio de sesión con Google, Apple ni códigos de un solo uso.', app.language)
                    adaptive_height: True
                Muted:
                    text: app.ui_text('Este texto describe el funcionamiento del prototipo. Las condiciones definitivas y la identificación del responsable del servicio están pendientes de revisión por el equipo.', app.language)
                PrimaryButton:
                    on_release: app.back()
                    MDButtonText:
                        text: app.ui_text('Volver', app.language)
# --------------------------------------------------------------- Registro
<RegisterScreen>:
    name: "register"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Crear cuenta', app.language)
        MDScrollView:
            Page:
                padding: dp(24), dp(16), dp(24), dp(32)
                MDTextField:
                    id: name
                    mode: "outlined"
                    write_tab: False
                    MDTextFieldLeadingIcon:
                        icon: "account-outline"
                    MDTextFieldHintText:
                        text: app.ui_text('Nombre', app.language)
                MDTextField:
                    id: email
                    mode: "outlined"
                    write_tab: False
                    MDTextFieldLeadingIcon:
                        icon: "email-outline"
                    MDTextFieldHintText:
                        text: app.ui_text('Correo', app.language)
                MDTextField:
                    id: password
                    mode: "outlined"
                    password: True
                    write_tab: False
                    MDTextFieldLeadingIcon:
                        icon: "lock-outline"
                    MDTextFieldHintText:
                        text: app.ui_text('Contraseña', app.language)
                    MDTextFieldHelperText:
                        text: app.ui_text('Mínimo 4 caracteres', app.language)
                        mode: "persistent"
                Gap:
                    # el texto de ayuda se dibuja bajo el campo: este espacio evita que toque la etiqueta
                    height: dp(4)
                FieldLabel:
                    text: app.ui_text('¿Cómo usarás la app?', app.language)
                SegmentedRow:
                    id: role
                    options: [(Role.READER, app.ui_text('Busco libros (Lector)', app.language)), (Role.SELLER, app.ui_text('Vendo libros (Vendedor)', app.language))]
                    value: Role.READER
                MDBoxLayout:
                    orientation: "vertical"
                    spacing: dp(4)
                    size_hint_y: None
                    height: self.minimum_height if role.value == Role.SELLER else 0
                    opacity: 1 if role.value == Role.SELLER else 0
                    disabled: role.value != Role.SELLER
                    FieldLabel:
                        text: app.ui_text('Tu comuna (para que los lectores vean qué tan cerca estás)', app.language)
                    MDTextField:
                        id: location
                        mode: "outlined"
                        on_text: root.on_location_text(self.text)
                        MDTextFieldLeadingIcon:
                            icon: "map-marker-outline"
                        MDTextFieldHintText:
                            text: app.ui_text('Ej: Concepción, Santiago…', app.language)
                    ListBox:
                        id: suggestions_box
                Muted:
                    text: app.ui_text('Las cuentas de administrador no se pueden crear desde aquí.', app.language)
                    role: "small"
                PrimaryButton:
                    on_release: root.do_register()
                    MDButtonText:
                        text: app.ui_text('Crear cuenta', app.language)
# ========================================================================
#  LECTOR
# ========================================================================
<ReaderHomeScreen>:
    name: "reader_home"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        HomeHeader:
            role_text: app.ui_text('Lector', app.language)
        MDScrollView:
            Page:
                padding: dp(24), dp(16), dp(24), dp(24)
                spacing: dp(16)
                Muted:
                    text: app.ui_text('Hola, ', app.language) + app.user_name
                    role: "small"
                MDLabel:
                    text: app.ui_text('Tu próximo libro\nempieza aquí.', app.language)
                    font_style: "Headline"
                    role: "medium"
                    bold: True
                    adaptive_height: True
                Muted:
                    text: app.ui_text('Busca un libro y recibe ofertas de vendedores que lo tienen.', app.language)
                SegmentedRow:
                    id: mode
                    options: [('titulo', app.ui_text('Título', app.language)), ('autor', app.ui_text('Autor', app.language)), ('isbn', 'ISBN')]
                    value: "titulo"
                MDTextField:
                    id: query
                    mode: "outlined"
                    on_text_validate: root.search()
                    MDTextFieldLeadingIcon:
                        icon: "magnify"
                    MDTextFieldHintText:
                        text: {'titulo': app.ui_text('¿Qué libro estás buscando?', app.language), 'autor': app.ui_text('¿Quién lo escribió?', app.language), 'isbn': app.ui_text('ISBN del libro', app.language)}.get(mode.value, '')
                PrimaryButton:
                    on_release: root.search()
                    MDButtonText:
                        text: app.ui_text('Buscar libro', app.language)
                MDGridLayout:
                    cols: 2
                    adaptive_height: True
                    StatLink:
                        id: stat_active
                        label: app.ui_text('Solicitudes activas', app.language)
                        padding: 0, dp(8), 0, dp(8)
                        on_release: app.go("reader_requests")
                    StatLink:
                        id: stat_offers
                        label: app.ui_text('Ofertas por revisar', app.language)
                        padding: 0, dp(8), 0, dp(8)
                        on_release: app.go("reader_requests")
                Rule:
                MDBoxLayout:
                    adaptive_height: True
                    MDLabel:
                        text: app.ui_text('Tus solicitudes', app.language)
                        font_style: "Title"
                        role: "medium"
                        bold: True
                        adaptive_height: True
                        pos_hint: {"center_y": .5}
                    MDButton:
                        style: "text"
                        on_release: app.go("reader_requests")
                        MDButtonText:
                            text: app.ui_text('Ver todas', app.language)
                ListBox:
                    id: recent_list
        HomeNav:

<BookSearchScreen>:
    name: "book_search"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Buscar libro', app.language)
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            MDTextField:
                id: query
                mode: "outlined"
                on_text_validate: root.search()
                MDTextFieldLeadingIcon:
                    icon: "magnify"
                MDTextFieldHintText:
                    text: app.ui_text('Título, autor o ISBN', app.language)
            SegmentedRow:
                id: mode
                options: [('titulo', app.ui_text('Título', app.language)), ('autor', app.ui_text('Autor', app.language)), ('isbn', 'ISBN')]
                value: "titulo"
            PrimaryButton:
                disabled: root.searching
                on_release: root.search()
                MDButtonText:
                    text: app.ui_text('Buscar', app.language)
            MDBoxLayout:
                adaptive_height: True
                spacing: dp(8)
                MDCircularProgressIndicator:
                    size_hint: None, None
                    size: dp(18), dp(18)
                    line_width: dp(2)
                    active: root.searching
                    opacity: 1 if root.searching else 0
                Muted:
                    text: root.status_text
                    role: "small"
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: results


<CreateRequestScreen>:
    name: "create_request"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Crear solicitud', app.language)
        MDScrollView:
            Page:
                BookHeader:
                    height: max(dp(124), header_content.minimum_height + dp(32))
                    BookCover:
                        id: cover
                        pos_hint: {"top": 1}
                    MDBoxLayout:
                        id: header_content
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(4)
                        pos_hint: {"top": 1}
                        Muted:
                            text: app.ui_text('Libro seleccionado', app.language)
                            font_style: "Label"
                        Heading:
                            id: book_title
                        Muted:
                            id: book_meta
                            role: "small"
                FieldLabel:
                    text: app.ui_text('Precio máximo (opcional)', app.language)
                MDTextField:
                    id: max_price
                    mode: "outlined"
                    input_filter: "int"
                    MDTextFieldLeadingIcon:
                        icon: "currency-usd"
                    MDTextFieldHintText:
                        text: app.ui_text('Ej: 15000', app.language)
                    MDTextFieldHelperText:
                        text: app.ui_text('Déjalo vacío si no tienes un máximo', app.language)
                        mode: "persistent"
                Gap:
                    height: dp(4)
                FieldLabel:
                    text: app.ui_text('¿En qué estado lo aceptas?', app.language)
                SegmentedRow:
                    id: condition
                    options: [(Condition.ANY, app.ui_text('Cualquiera', app.language)), (Condition.NEW, app.ui_text('Nuevo', app.language)), (Condition.USED, app.ui_text('Usado', app.language))]
                    value: Condition.ANY
                FieldLabel:
                    text: app.ui_text('¿Dónde buscas el libro?', app.language)
                MDTextField:
                    id: location
                    mode: "outlined"
                    on_text: root.on_location_text(self.text)
                    MDTextFieldLeadingIcon:
                        icon: "map-marker-outline"
                    MDTextFieldHintText:
                        text: app.ui_text('Ej: Concepción, Santiago…', app.language)
                    MDTextFieldHelperText:
                        text: app.ui_text('Escribe para buscar tu comuna o ciudad', app.language)
                        mode: "persistent"
                Gap:
                    height: dp(4)
                ListBox:
                    id: suggestions_box
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(6)
                    padding: 0, dp(4), 0, 0
                    Muted:
                        text: app.ui_text('Rápido:', app.language)
                        adaptive_width: True
                        font_style: "Label"
                        role: "small"
                        pos_hint: {"center_y": .5}
                    # WideButton centra el texto: con MDButton de ancho fijo se salía del borde a 360 dp
                    WideButton:
                        style: "outlined"
                        size_hint_y: None
                        on_release: root.select_location("Concepción (Biobío)")
                        MDButtonText:
                            text: 'Concepción'
                    WideButton:
                        style: "outlined"
                        size_hint_y: None
                        on_release: root.select_location("Santiago (Metropolitana)")
                        MDButtonText:
                            text: 'Santiago'
                    WideButton:
                        style: "outlined"
                        size_hint_y: None
                        on_release: root.select_location("Valparaíso (Valparaíso)")
                        MDButtonText:
                            text: 'Valparaíso'
                FieldLabel:
                    text: app.ui_text('Preferencia de entrega', app.language)
                SegmentedRow:
                    id: delivery
                    options: [(Delivery.IN_PERSON, app.ui_text('Presencial', app.language)), (Delivery.SHIPPING, app.ui_text('Envío', app.language)), (Delivery.ANY, app.ui_text('Cualquiera', app.language))]
                    value: Delivery.ANY
                FieldLabel:
                    text: app.ui_text('¿Algo más que debamos saber? (opcional)', app.language)
                MDTextField:
                    id: notes
                    mode: "outlined"
                    multiline: True
                    max_height: dp(140)
                    MDTextFieldHintText:
                        text: app.ui_text('Por ejemplo, una edición o un idioma en particular', app.language)
                Widget:
                    size_hint_y: None
                    height: dp(4)
                PrimaryButton:
                    on_release: root.publish()
                    MDButtonIcon:
                        icon: "send"
                    MDButtonText:
                        text: app.ui_text('Publicar solicitud', app.language)


<RequestPublishedScreen>:
    name: "request_published"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        MDBoxLayout:
            size_hint_y: None
            height: dp(56)
            padding: 0, dp(4), dp(8), 0
            Widget:
            MDIconButton:
                icon: "close"
                pos_hint: {"center_y": .5}
                theme_icon_color: "Custom"
                icon_color: hex(app.ui_palette["ink"])
                on_release: app.go_home()
        MDScrollView:
            MDBoxLayout:
                orientation: "vertical"
                adaptive_height: True
                padding: dp(22), dp(18), dp(22), dp(16)
                MDAnchorLayout:
                    size_hint: None, None
                    size: dp(56), dp(56)
                    radius: [dp(28)] * 4
                    line_color: app.theme_cls.primaryColor
                    line_width: dp(1)
                    MDIcon:
                        icon: "check"
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.primaryColor
                Gap:
                    height: dp(24)
                MDLabel:
                    id: request_id
                    font_style: "Label"
                    role: "large"
                    bold: True
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(app.ui_palette["muted"])
                Gap:
                    height: dp(8)
                MDLabel:
                    text: app.ui_text('Tu solicitud está publicada', app.language)
                    font_style: "Headline"
                    role: "large"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(app.ui_palette["ink"])
                Gap:
                    height: dp(8)
                MDLabel:
                    text: app.ui_text('Los vendedores ya pueden verla y enviarte ofertas.', app.language)
                    font_style: "Body"
                    role: "large"
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(app.ui_palette["muted"])
                Gap:
                    height: dp(24)
                Rule:
                ListBox:
                    id: request_row
                Gap:
                    height: dp(28)
                MDLabel:
                    text: app.ui_text('Qué pasa ahora', app.language)
                    font_style: "Label"
                    role: "large"
                    bold: True
                    adaptive_height: True
                    theme_text_color: "Custom"
                    text_color: hex(app.ui_palette["ink"])
                Gap:
                    height: dp(8)
                NextStep:
                    number: "1"
                    text: app.ui_text('Los vendedores que tengan el libro te envían una oferta.', app.language)
                NextStep:
                    number: "2"
                    text: app.ui_text('Comparas precio, estado y ubicación, y aceptas una.', app.language)
                NextStep:
                    number: "3"
                    text: app.ui_text('Ves los datos de contacto del vendedor para coordinar.', app.language)
        MDBoxLayout:
            orientation: "vertical"
            adaptive_height: True
            padding: dp(22), dp(8), dp(22), dp(24)
            spacing: dp(10)
            WideButton:
                style: "filled"
                radius: [dp(12)] * 4
                on_release: app.open_reader_request(app.current_request_id)
                MDButtonText:
                    text: app.ui_text('Ver solicitud', app.language)
            WideButton:
                style: "outlined"
                radius: [dp(12)] * 4
                on_release: app.go_home()
                MDButtonText:
                    text: app.ui_text('Volver al inicio', app.language)


<ReaderRequestsScreen>:
    name: "reader_requests"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Mis solicitudes', app.language)
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            SegmentedRow:
                id: filter
                options: [('todas', app.ui_text('Todas', app.language)), ('activas', app.ui_text('Activas', app.language)), ('resueltas', app.ui_text('Resueltas', app.language)), ('canceladas', app.ui_text('Canceladas', app.language))]
                value: "todas"
                on_value: root.refresh()
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list


<ReaderRequestDetailScreen>:
    name: "reader_request_detail"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Detalle de solicitud', app.language)
        MDScrollView:
            Page:
                BookHeader:
                    height: max(dp(124), header_content.minimum_height + dp(32))
                    BookCover:
                        id: cover
                        pos_hint: {"top": 1}
                    MDBoxLayout:
                        id: header_content
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(6)
                        pos_hint: {"top": 1}
                        Heading:
                            id: book_title
                        Muted:
                            id: book_meta
                            role: "small"
                        StatusChip:
                            id: status
                            kind: "request"
                Panel:
                    spacing: dp(2)
                    ListBox:
                        id: info
                        spacing: dp(2)
                Heading:
                    id: offers_title
                ListBox:
                    id: offers
                WideButton:
                    style: "outlined"
                    height: dp(48) if root.can_cancel else 0
                    opacity: 1 if root.can_cancel else 0
                    disabled: not root.can_cancel
                    on_release: root.cancel()
                    MDButtonText:
                        text: app.ui_text('Cancelar solicitud', app.language)
                        theme_text_color: "Custom"
                        text_color: app.theme_cls.errorColor


<OfferDetailScreen>:
    name: "offer_detail"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Detalle de oferta', app.language)
        MDScrollView:
            Page:
                HomeHeader:
                    role_text: app.ui_text('Lector', app.language) if app.user and app.user.role == Role.READER else app.ui_text('Vendedor', app.language)
                    padding: 0, dp(8)
                StatusChip:
                    id: status
                    kind: "offer"
                MDBoxLayout:
                    size_hint_y: None
                    height: max(dp(110), offer_book.minimum_height)
                    spacing: dp(18)
                    BookCover:
                        id: cover
                        size: dp(76), dp(110)
                        pos_hint: {"top": 1}
                    MDBoxLayout:
                        id: offer_book
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(8)
                        MDLabel:
                            id: book_title
                            font_style: "Title"
                            role: "large"
                            bold: True
                            adaptive_height: True
                        Muted:
                            id: book_author
                            role: "small"
                        Muted:
                            id: seller_name
                            role: "small"
                Rule:
                MDLabel:
                    id: price
                    font_style: "Display"
                    role: "small"
                    bold: True
                    adaptive_height: True
                    text_color: app.theme_cls.primaryColor
                Muted:
                    text: app.ui_text('Precio ofrecido · pesos chilenos', app.language)
                    role: "small"
                Panel:
                    spacing: dp(2)
                    ListBox:
                        id: info
                        spacing: dp(2)
                Panel:
                    md_bg_color: hex(app.ui_palette["soft"])
                    opacity: 1 if root.can_accept else 0
                    height: self.minimum_height if root.can_accept else 0
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "shield-lock-outline"
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            text: app.ui_text('El siguiente paso: al aceptar verás el contacto del vendedor. La compra y la entrega se acuerdan directamente entre ustedes.', app.language)
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
                Panel:
                    md_bg_color: hex(app.ui_palette["soft"])
                    opacity: 1 if root.in_deal else 0
                    height: self.minimum_height if root.in_deal else 0
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "handshake-outline"
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            text: app.ui_text('Oferta en coordinación. Comunícate con el vendedor mediante sus datos de contacto.', app.language)
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
                Panel:
                    md_bg_color: hex(app.ui_palette["soft"])
                    opacity: 1 if root.on_hold else 0
                    height: self.minimum_height if root.on_hold else 0
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "clock-outline"
                            pos_hint: {"center_y": .5}
                        MDLabel:
                            text: app.ui_text('Esta oferta está en espera mientras el lector coordina con otra oferta. Si no se concreta, se reactivará.', app.language)
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
        MDBoxLayout:
            orientation: "vertical"
            size_hint_y: None
            height: self.minimum_height if (root.can_accept or root.in_deal or root.accepted) else 0
            opacity: 1 if (root.can_accept or root.in_deal or root.accepted) else 0
            padding: dp(24), dp(8), dp(24), dp(16)
            md_bg_color: app.theme_cls.backgroundColor
            PrimaryButton:
                opacity: 1 if root.can_accept else 0
                disabled: not root.can_accept
                height: dp(52) if root.can_accept else 0
                on_release: root.accept()
                MDButtonIcon:
                    icon: "handshake-outline"
                MDButtonText:
                    text: app.ui_text('Aceptar para coordinar', app.language)
            PrimaryButton:
                opacity: 1 if (root.in_deal or root.accepted) else 0
                disabled: not (root.in_deal or root.accepted)
                height: dp(52) if (root.in_deal or root.accepted) else 0
                on_release: app.go("offer_accepted")
                MDButtonIcon:
                    icon: "card-account-phone-outline"
                MDButtonText:
                    text: app.ui_text('Ver datos de contacto', app.language)
            PrimaryButton:
                opacity: 1 if (root.in_deal and root.is_reader) else 0
                disabled: not (root.in_deal and root.is_reader)
                height: dp(52) if (root.in_deal and root.is_reader) else 0
                on_release: root.confirm_deal()
                MDButtonIcon:
                    icon: "check-circle-outline"
                MDButtonText:
                    text: app.ui_text('Confirmar compra concretada', app.language)
            WideButton:
                style: "outlined"
                opacity: 1 if (root.in_deal and root.is_reader) else 0
                disabled: not (root.in_deal and root.is_reader)
                height: dp(48) if (root.in_deal and root.is_reader) else 0
                on_release: root.cancel_deal()
                MDButtonText:
                    text: app.ui_text('Desistir del trato', app.language)
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.errorColor

<OfferAcceptedScreen>:
    name: "offer_accepted"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Oferta aceptada', app.language)
        MDScrollView:
            Page:
                padding: dp(16), dp(24), dp(16), dp(32)
                spacing: dp(14)
                MDIcon:
                    icon: "handshake"
                    font_size: "64sp"
                    pos_hint: {"center_x": .5}
                    theme_text_color: "Custom"
                    text_color: app.theme_cls.primaryColor
                MDLabel:
                    text: app.ui_text('Ya pueden ponerse de acuerdo', app.language)
                    halign: "center"
                    font_style: "Headline"
                    role: "medium"
                    bold: True
                    adaptive_height: True
                Muted:
                    id: summary
                    halign: "center"
                Panel:
                    Heading:
                        text: app.ui_text('Contacto del vendedor', app.language)
                        role: "small"
                    ListBox:
                        id: contact
                        spacing: dp(2)
                Panel:
                    md_bg_color: hex(app.ui_palette["soft"])
                    MDBoxLayout:
                        adaptive_height: True
                        spacing: dp(12)
                        MDIcon:
                            icon: "information-outline"
                            pos_hint: {"top": 1}
                            theme_text_color: "Custom"
                            text_color: hex(app.ui_palette["ink"])
                        MDLabel:
                            text: app.ui_text('La compra y la entrega se coordinan directamente entre tú y el vendedor. La app no procesa pagos ni envíos.', app.language)
                            font_style: "Body"
                            role: "medium"
                            adaptive_height: True
                            theme_text_color: "Custom"
                            text_color: hex(app.ui_palette["ink"])
                PrimaryButton:
                    on_release: app.go_home()
                    MDButtonText:
                        text: app.ui_text('Volver al inicio', app.language)


# ========================================================================
#  VENDEDOR
# ========================================================================
<SellerHomeScreen>:
    name: "seller_home"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        HomeHeader:
            role_text: app.ui_text('Vendedor', app.language)
        MDScrollView:
            Page:
                spacing: dp(16)
                Muted:
                    text: app.ui_text('SOLICITUDES DISPONIBLES', app.language)
                    role: "small"
                    text_color: app.theme_cls.primaryColor
                MDLabel:
                    text: app.ui_text('Alguien busca ese\nlibro que tienes.', app.language)
                    font_style: "Headline"
                    role: "medium"
                    bold: True
                    adaptive_height: True
                Muted:
                    text: app.ui_text('Encuentra lectores y envía tu oferta.', app.language)
                MDTextField:
                    id: text
                    mode: "outlined"
                    on_text: root.refresh()
                    MDTextFieldLeadingIcon:
                        icon: "magnify"
                    MDTextFieldHintText:
                        text: app.ui_text('Título, autor o ISBN', app.language)
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(12)
                    MDTextField:
                        id: location
                        mode: "outlined"
                        on_text: root.refresh()
                        MDTextFieldHintText:
                            text: app.ui_text('Comuna o ciudad', app.language)
                    MDTextField:
                        id: budget
                        mode: "outlined"
                        input_filter: "int"
                        on_text: root.refresh()
                        MDTextFieldHintText:
                            text: app.ui_text('Presupuesto mín.', app.language)
                MDBoxLayout:
                    adaptive_height: True
                    spacing: dp(8)
                    SegmentedRow:
                        id: condition
                        options: [('todas', app.ui_text('Todas', app.language)), (Condition.NEW, app.ui_text('Nuevo', app.language)), (Condition.USED, app.ui_text('Usado', app.language))]
                        value: "todas"
                        on_value: root.refresh()
                    MDIconButton:
                        icon: "filter-remove-outline"
                        on_release: root.clear_filters()
                        pos_hint: {"center_y": .5}
                Rule:
                Heading:
                    text: app.ui_text('Búsquedas recientes', app.language)
                Muted:
                    id: count
                    role: "small"
                ListBox:
                    id: list
                Muted:
                    text: app.ui_text('¿Tienes un libro que alguien busca? Abre su solicitud y cuéntale qué ofreces.', app.language)
                    role: "small"
        HomeNav:
            seller: True

<SellerRequestDetailScreen>:
    name: "seller_request_detail"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Solicitud', app.language)
        MDScrollView:
            Page:
                BookHeader:
                    height: max(dp(124), header_content.minimum_height + dp(32))
                    BookCover:
                        id: cover
                        pos_hint: {"top": 1}
                    MDBoxLayout:
                        id: header_content
                        orientation: "vertical"
                        adaptive_height: True
                        spacing: dp(6)
                        pos_hint: {"top": 1}
                        Heading:
                            id: book_title
                        Muted:
                            id: book_meta
                            role: "small"
                        StatusChip:
                            id: status
                            kind: "request"
                Panel:
                    spacing: dp(2)
                    ListBox:
                        id: info
                        spacing: dp(2)
                Panel:
                    md_bg_color: hex(app.ui_palette["soft"])
                    opacity: 1 if root.offer_note else 0
                    height: self.minimum_height if root.offer_note else 0
                    MDLabel:
                        text: root.offer_note
                        font_style: "Body"
                        role: "medium"
                        adaptive_height: True
                PrimaryButton:
                    opacity: 1 if root.can_offer else 0
                    disabled: not root.can_offer
                    height: dp(52) if root.can_offer else 0
                    on_release: app.go("create_offer")
                    MDButtonIcon:
                        icon: "hand-extended-outline"
                    MDButtonText:
                        text: app.ui_text('Puedo ofrecerlo', app.language)


<CreateOfferScreen>:
    name: "create_offer"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Crear oferta', app.language)
        MDScrollView:
            Page:
                Panel:
                    Heading:
                        id: book_title
                    Muted:
                        id: book_meta
                        role: "small"
                FieldLabel:
                    text: app.ui_text('Precio', app.language)
                MDTextField:
                    id: price
                    mode: "outlined"
                    input_filter: "int"
                    MDTextFieldLeadingIcon:
                        icon: "currency-usd"
                    MDTextFieldHintText:
                        text: app.ui_text('Ej: 12990', app.language)
                FieldLabel:
                    text: app.ui_text('Estado del libro', app.language)
                SegmentedRow:
                    id: condition
                    options: [(Condition.NEW, app.ui_text('Nuevo', app.language)), (Condition.USED, app.ui_text('Usado', app.language))]
                    value: Condition.USED
                MDTextField:
                    id: description
                    mode: "outlined"
                    MDTextFieldHintText:
                        text: app.ui_text('Condición (ej: sin subrayar)', app.language)
                MDTextField:
                    id: notes
                    mode: "outlined"
                    multiline: True
                    max_height: dp(120)
                    MDTextFieldHintText:
                        text: app.ui_text('Información adicional (opcional)', app.language)
                MDDivider:
                FieldLabel:
                    text: app.ui_text('Datos de contacto', app.language)
                Muted:
                    text: app.ui_text('Elige cómo quieres que te contacten. El lector verá estos datos al aceptar tu oferta.', app.language)
                    role: "small"
                MDTextField:
                    id: phone
                    mode: "outlined"
                    MDTextFieldLeadingIcon:
                        icon: "phone-outline"
                    MDTextFieldHintText:
                        text: app.ui_text('Teléfono', app.language)
                MDTextField:
                    id: email
                    mode: "outlined"
                    MDTextFieldLeadingIcon:
                        icon: "email-outline"
                    MDTextFieldHintText:
                        text: app.ui_text('Correo', app.language)
                MDTextField:
                    id: address
                    mode: "outlined"
                    MDTextFieldLeadingIcon:
                        icon: "map-marker-outline"
                    MDTextFieldHintText:
                        text: app.ui_text('Dirección o punto de entrega', app.language)
                Widget:
                    size_hint_y: None
                    height: dp(4)
                PrimaryButton:
                    on_release: root.publish()
                    MDButtonIcon:
                        icon: "send"
                    MDButtonText:
                        text: app.ui_text('Publicar oferta', app.language)


<SellerOffersScreen>:
    name: "seller_offers"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Mis ofertas', app.language)
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            SegmentedRow:
                id: filter
                options: [('todas', app.ui_text('Todas', app.language)), ('activas', app.ui_text('Activas', app.language)), ('aceptadas', app.ui_text('Aceptadas', app.language)), ('finalizadas', app.ui_text('Finalizadas', app.language))]
                value: "todas"
                on_value: root.refresh()
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list


# ========================================================================
#  ADMINISTRADOR
# ========================================================================
<AdminHomeScreen>:
    name: "admin_home"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        MDTopAppBar:
            type: "small"
            MDTopAppBarTitle:
                text: app.ui_text('Administración', app.language)
            MDTopAppBarTrailingButtonContainer:
                MDActionTopAppBarButton:
                    icon: "refresh"
                    on_release: root.refresh()
                MDActionTopAppBarButton:
                    icon: "logout"
                    on_release: app.logout()
        MDScrollView:
            Page:
                MDGridLayout:
                    cols: 3
                    spacing: dp(10)
                    adaptive_height: True
                    StatTile:
                        id: st_usuarios
                        label: app.ui_text('Usuarios', app.language)
                        icon: "account-group-outline"
                    StatTile:
                        id: st_lectores
                        label: app.ui_text('Lectores', app.language)
                        icon: "account-search-outline"
                    StatTile:
                        id: st_vendedores
                        label: app.ui_text('Vendedores', app.language)
                        icon: "storefront-outline"
                    StatTile:
                        id: st_solicitudes
                        label: app.ui_text('Solicitudes', app.language)
                        icon: "file-document-outline"
                    StatTile:
                        id: st_activas
                        label: app.ui_text('Activas', app.language)
                        icon: "flash-outline"
                    StatTile:
                        id: st_con_ofertas
                        label: app.ui_text('Con ofertas', app.language)
                        icon: "tag-outline"
                    StatTile:
                        id: st_resueltas
                        label: app.ui_text('Resueltas', app.language)
                        icon: "check-decagram-outline"
                    StatTile:
                        id: st_canceladas
                        label: app.ui_text('Canceladas', app.language)
                        icon: "close-circle-outline"
                    StatTile:
                        id: st_ofertas
                        label: app.ui_text('Ofertas', app.language)
                        icon: "handshake-outline"
                Heading:
                    text: app.ui_text('Gestión', app.language)
                    role: "small"
                Panel:
                    spacing: dp(2)
                    MDListItem:
                        on_release: app.go("admin_requests")
                        MDListItemLeadingIcon:
                            icon: "clipboard-text-outline"
                        MDListItemHeadlineText:
                            text: app.ui_text('Solicitudes', app.language)
                        MDListItemSupportingText:
                            text: app.ui_text('Ver, filtrar y moderar solicitudes', app.language)
                    MDListItem:
                        on_release: app.go("admin_users")
                        MDListItemLeadingIcon:
                            icon: "account-multiple-outline"
                        MDListItemHeadlineText:
                            text: app.ui_text('Usuarios', app.language)
                        MDListItemSupportingText:
                            text: app.ui_text('Consultar y suspender usuarios', app.language)
                    MDListItem:
                        on_release: app.go("admin_offers")
                        MDListItemLeadingIcon:
                            icon: "tag-multiple-outline"
                        MDListItemHeadlineText:
                            text: app.ui_text('Ofertas', app.language)
                        MDListItemSupportingText:
                            text: app.ui_text('Historial de ofertas de la plataforma', app.language)
                    MDListItem:
                        on_release: app.go("admin_activity")
                        MDListItemLeadingIcon:
                            icon: "history"
                        MDListItemHeadlineText:
                            text: app.ui_text('Auditoría / Actividad', app.language)
                        MDListItemSupportingText:
                            text: app.ui_text('Buscar y exportar logs de actividad', app.language)


<AdminRequestsScreen>:
    name: "admin_requests"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Solicitudes', app.language)
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            SegmentedRow:
                id: filter
                options: [('todas', app.ui_text('Todas', app.language)), ('activas', app.ui_text('Activas', app.language)), ('resueltas', app.ui_text('Resueltas', app.language)), ('canceladas', app.ui_text('Canceladas', app.language))]
                value: "todas"
                on_value: root.refresh()
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list


<AdminUsersScreen>:
    name: "admin_users"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Usuarios', app.language)
        MDScrollView:
            Page:
                padding: dp(24), dp(16), dp(24), dp(32)
                ListBox:
                    id: list


<AdminOffersScreen>:
    name: "admin_offers"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Ofertas', app.language)
        MDScrollView:
            Page:
                padding: dp(24), dp(16), dp(24), dp(32)
                ListBox:
                    id: list


<AdminActivityScreen>:
    name: "admin_activity"
    md_bg_color: app.theme_cls.backgroundColor
    MDBoxLayout:
        orientation: "vertical"
        BackBar:
            title: app.ui_text('Auditoría / Actividad', app.language)
        Page:
            padding: dp(16), dp(12), dp(16), dp(4)
            MDTextField:
                id: search
                mode: "outlined"
                on_text: root.refresh()
                MDTextFieldLeadingIcon:
                    icon: "magnify"
                MDTextFieldHintText:
                    text: app.ui_text('Buscar por acción, detalle o actor', app.language)
            PrimaryButton:
                on_release: root.export_logs()
                MDButtonIcon:
                    icon: "download"
                MDButtonText:
                    text: app.ui_text('Exportar logs de actividad', app.language)
        MDScrollView:
            Page:
                padding: dp(16), dp(4), dp(16), dp(32)
                ListBox:
                    id: list
